<?xml version="1.0"?>
<launch>
  <!-- group for racecar -->
  <group ns="racecar1">
    <!-- Open the model file -->
    <arg name="racecar1_xacro" default="$(find f1tenth_simulator)/racecar1.xacro"/>
    <!--<param name="tf_prefix" value="racecar"/>-->
    <param name="robot_description" command="xacro --inorder '$(arg racecar1_xacro)'"/>
    <!-- Add the transformations -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" />
  </group>

  <group ns="racecar2">
    <arg name="racecar2_xacro" default="$(find f1tenth_simulator)/racecar2.xacro"/>
    <param name="robot_description" command="xacro --inorder '$(arg racecar2_xacro)'"/>
    <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
  </group>

</launch>
